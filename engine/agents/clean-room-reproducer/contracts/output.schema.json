{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "attempts", "successes", "environment_hash", "artifact_ids", "deviations", "replay_steps"],
  "properties": {
    "verdict": {"enum": ["reproduced", "refuted", "inconclusive"]},
    "attempts": {"type": "integer", "minimum": 1},
    "successes": {"type": "integer", "minimum": 0},
    "environment_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "replay_steps": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}

