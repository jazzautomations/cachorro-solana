{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "scope_receipt_id", "artifact_roots", "graph_revision"],
  "properties": {
    "question": {"type": "string", "minLength": 15},
    "scope_receipt_id": {"type": "string", "minLength": 8},
    "artifact_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "seed_locations": {"type": "array", "items": {"type": "string"}},
    "graph_revision": {"type": "integer", "minimum": 0}
  }
}

