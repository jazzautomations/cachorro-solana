{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["dossier_ids", "graph_revision", "requested_lenses"],
  "properties": {
    "dossier_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "variant_seed_ids": {"type": "array", "items": {"type": "string"}},
    "graph_revision": {"type": "integer", "minimum": 0},
    "requested_lenses": {"type": "array", "minItems": 2, "items": {"type": "string"}}
  }
}

