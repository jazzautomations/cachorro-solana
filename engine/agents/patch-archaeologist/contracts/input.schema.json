{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository_artifact_id", "question", "seed_locations", "graph_revision"],
  "properties": {
    "repository_artifact_id": {"type": "string", "minLength": 8},
    "question": {"type": "string", "minLength": 15},
    "seed_locations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "known_fix_ids": {"type": "array", "items": {"type": "string"}},
    "graph_revision": {"type": "integer", "minimum": 0}
  }
}

