{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis_id", "mechanism", "preconditions", "evidence_ids", "scope_receipt_id"],
  "properties": {
    "hypothesis_id": {"type": "string", "minLength": 8},
    "mechanism": {"type": "string", "minLength": 20},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "claimed_oracle": {"type": "string"},
    "scope_receipt_id": {"type": "string", "minLength": 8}
  }
}

