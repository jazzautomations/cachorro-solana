{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentest-agent.local/schemas/agent-manifest.schema.json",
  "title": "Pentest-Agent agent package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "name", "version", "description", "instruction",
    "capabilities", "tools", "side_effects", "budgets", "contracts"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 20, "maxLength": 500},
    "instruction": {"type": "string", "pattern": "^AGENT\\.md$"},
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "mode", "mutates_target"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "mode": {"enum": ["read", "analyze", "execute"]},
          "mutates_target": {"type": "boolean"},
          "requires_approval": {"type": "boolean", "default": false}
        }
      }
    },
    "side_effects": {
      "type": "array", "uniqueItems": true,
      "items": {
        "enum": [
          "none", "workspace_write", "network_read", "target_state_change",
          "credential_use", "code_execution", "external_service", "destructive_test"
        ]
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_turns", "max_tool_calls", "max_wall_seconds"],
      "properties": {
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {"type": "string"},
        "output": {"type": "string"}
      }
    },
    "skills": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string"}
    },
    "child_agents": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string"}
    },
    "runtime_requirements": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}

