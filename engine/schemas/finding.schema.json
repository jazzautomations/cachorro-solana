{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentest-agent.local/schemas/finding.schema.json",
  "title": "Reportable verified finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "finding_id", "title", "mechanism", "impact",
    "preconditions", "primitive_ids", "evidence_ids", "clean_room_reproduction",
    "skeptic_review", "scope_receipt_id", "status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "finding_id": {"type": "string", "minLength": 8},
    "title": {"type": "string", "minLength": 10},
    "mechanism": {"type": "string", "minLength": 20},
    "impact": {"type": "string", "minLength": 20},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "primitive_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "clean_room_reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "reviewer", "verified_at"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 8},
        "reviewer": {"type": "string", "minLength": 2},
        "verified_at": {"type": "string", "format": "date-time"}
      }
    },
    "skeptic_review": {"type": "string", "minLength": 20},
    "scope_receipt_id": {"type": "string", "minLength": 8},
    "status": {"enum": ["verified", "reported", "accepted", "duplicate", "refuted"]}
  }
}
