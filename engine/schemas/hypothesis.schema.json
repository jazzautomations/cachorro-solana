{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentest-agent.local/schemas/hypothesis.schema.json",
  "title": "Falsifiable vulnerability hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "hypothesis_id", "mechanism", "preconditions",
    "predicted_effect", "falsifier", "supporting_observation_ids", "status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "hypothesis_id": {"type": "string", "minLength": 8},
    "mechanism": {"type": "string", "minLength": 20},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "predicted_effect": {"type": "string", "minLength": 10},
    "falsifier": {"type": "string", "minLength": 10},
    "supporting_observation_ids": {"type": "array", "items": {"type": "string"}},
    "contradicting_observation_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["proposed", "testing", "supported", "refuted", "stale"]}
  }
}

