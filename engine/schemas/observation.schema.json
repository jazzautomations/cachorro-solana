{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentest-agent.local/schemas/observation.schema.json",
  "title": "Normalized observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observation_id", "kind", "statement", "artifact_ids",
    "source", "confidence", "status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "observation_id": {"type": "string", "minLength": 8},
    "kind": {"enum": ["static", "dynamic", "network", "history", "osint", "model"]},
    "statement": {"type": "string", "minLength": 5},
    "artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "version", "agent_package_hash"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "agent_package_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["observed", "inferred", "refuted", "stale"]}
  }
}

